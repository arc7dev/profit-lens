# Dependencies — pure tooling, never touched by WordPress at runtime (the
# plugin uses its own autoloader, not vendor/autoload.php; see
# includes/class-plugin.php).
node_modules/
vendor/

# build/ and assets/fonts/*.woff2 (+ assets/css/fonts.css) ARE versioned,
# on purpose: this repo is the folder that gets cloned straight into
# wp-content/plugins/. The end user doesn't run `npm run build` or
# `npm run fonts` — if those artifacts aren't committed, cloning the repo
# gives an activatable but broken plugin (uncompiled dashboard, missing
# fonts). Anyone touching src/ has to run `npm run build` before
# committing — see README.md.

# Packaging
*.zip

# Logs
*.log

# Editor / OS
.DS_Store
